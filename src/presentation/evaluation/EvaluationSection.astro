---
// conteúdo da página /avaliacao. Sem JS tudo aparece pronto (a busca e os efeitos são só melhoria): o texto final já
// vem no HTML e o mountEvaluation embaralha e "trava" cada linha quando ela entra na tela
import PageHalo from '@presentation/components/layout/PageHalo.astro';
import EvaluationRow from './EvaluationRow.astro';
import SectionHeader from '@presentation/sections/shared/SectionHeader.astro';
import { CRITERIA, FINALISTS, MAX_POINTS, type Ranking } from '@domain/evaluation/Ranking';
import { formatGrade, formatOrdinal } from '@presentation/formatters/evaluationFormat';
import '@presentation/sections/sections.css';
import './evaluation.css';

interface Props {
  ranking: Ranking;
}

const { ranking } = Astro.props;
const total = ranking.projects.length;

const method = [
  'Foi avaliada a versão final de cada repositório entregue no formulário da Entrega 1, como estava na tarde de 14/11.',
  'Cada projeto teve o código lido e, sempre que possível, executado. Telas, documentação e vídeo de pitch também contaram.',
  'O prazo de entrega era 14/11, às 13h. Cada commit feito depois disso descontou 0,5 ponto da soma dos critérios.',
  'Empates foram desfeitos pela maior soma de aderência e implementação, depois pelo vídeo de pitch dentro do tempo e, por fim, pela ordem alfabética.',
  `As ${FINALISTS} primeiras da classificação geral foram as finalistas que se apresentaram na final.`,
];

const scale = [
  { range: '90 a 100', label: 'Excepcional' },
  { range: '75 a 89', label: 'Forte' },
  { range: '55 a 74', label: 'Bom' },
  { range: '35 a 54', label: 'Fraco' },
  { range: 'até 34', label: 'Muito fraco' },
];
---

<section class="section ev tone-cyan" aria-labelledby="ev-title">
  <PageHalo />
  <canvas class="ev-rain" data-ev-rain aria-hidden="true"></canvas>

  <div class="container section-stack ev__stack">
    <div class="ev__head">
      <SectionHeader
        id="ev-title"
        level="h1"
        size="lg"
        code="AV"
        eyebrow="Resultado oficial"
        title="Avaliação técnica <em>dos projetos</em>"
        lead="As notas finais da entrega dos projetos do HackaRun 2026, critério por critério. Toque em uma linha da classificação para ler o resumo do projeto."
      />
      <ul class="ev-stats" aria-label="Resumo da avaliação">
        <li>
          <strong data-ev-count={total}>{total}</strong> projetos avaliados
        </li>
        <li>
          <strong data-ev-count={FINALISTS}>{FINALISTS}</strong> finalistas
        </li>
        <li>
          <strong data-ev-count={MAX_POINTS}>{MAX_POINTS}</strong> pontos possíveis
        </li>
      </ul>
    </div>

    <section class="ev-block" aria-labelledby="ev-finalists">
      <h2 class="ev-block__title" id="ev-finalists">
        <span aria-hidden="true">01</span> Finalistas
      </h2>
      <ol class="ev-podium">
        {ranking.finalists.map((p) => (
          <li class:list={['ev-podium__card', { 'ev-podium__card--first': p.rank === 1 }]} data-ev-reveal>
            <span class="ev-podium__rank">{formatOrdinal(p.rank)}</span>
            <span class="ev-podium__team" data-ev-scramble>
              Equipe {p.team}
            </span>
            <span class="ev-podium__project" data-ev-scramble>
              {p.project}
            </span>
            <span class="ev-podium__grade">
              <strong data-ev-number>{formatGrade(p.grade)}</strong>
              <small>/100</small>
            </span>
          </li>
        ))}
      </ol>
    </section>

    <div class="ev-split">
      <section class="ev-block" aria-labelledby="ev-criteria">
        <h2 class="ev-block__title" id="ev-criteria">
          <span aria-hidden="true">02</span> Critérios
        </h2>
        <ul class="ev-criteria">
          {CRITERIA.map((c) => (
            <li class="ev-criteria__item" data-ev-reveal style={`--share:${c.max / MAX_POINTS}`}>
              <span class="ev-criteria__name">{c.name}</span>
              <span class="ev-criteria__points">{c.max} pts</span>
              <span class="ev-criteria__bar" aria-hidden="true" />
            </li>
          ))}
        </ul>
        <ul class="ev-scale" aria-label="Escala das notas">
          {scale.map((s) => (
            <li>
              <strong>{s.range}</strong> {s.label}
            </li>
          ))}
        </ul>
      </section>

      <section class="ev-block" aria-labelledby="ev-method">
        <h2 class="ev-block__title" id="ev-method">
          <span aria-hidden="true">03</span> Como avaliamos
        </h2>
        <ol class="ev-method">
          {method.map((line) => (
            <li data-ev-reveal>{line}</li>
          ))}
        </ol>
      </section>
    </div>

    <section class="ev-block" aria-labelledby="ev-ranking">
      <h2 class="ev-block__title" id="ev-ranking">
        <span aria-hidden="true">04</span> Classificação geral
      </h2>

      <div class="ev-search" role="search">
        <label class="ev-search__label" for="ev-query">
          Buscar equipe ou projeto
        </label>
        <div class="ev-search__field">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            id="ev-query"
            type="search"
            data-ev-query
            placeholder="Ex.: Hypno, Rota Dourada"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <p class="ev-search__status" data-ev-status aria-live="polite">
          {total} projetos
        </p>
      </div>

      <div class="ev-table">
        <div class="ev-row ev-row--head" aria-hidden="true">
          <span>#</span>
          <span>Equipe e projeto</span>
          {CRITERIA.map((c) => (
            <span class="ev-col-score" title={`${c.name} (${c.max})`}>
              {c.short}
              <small>/{c.max}</small>
            </span>
          ))}
          <span class="ev-col-score">
            Soma<small>/100</small>
          </span>
          <span class="ev-col-score" title="Penalidade de prazo e ajustes da coordenação">
            Penal.
          </span>
          <span class="ev-col-grade">
            Nota<small>/100</small>
          </span>
          <span class="ev-col-score">Coef.</span>
        </div>

        <ol class="ev-list" data-ev-list>
          {ranking.projects.map((p) => (
            <EvaluationRow p={p} />
          ))}
        </ol>
        <p class="ev-empty" data-ev-empty hidden>
          Nenhuma equipe ou projeto com esse nome.
        </p>
      </div>
      <p class="ev-note">
        Penalidade: desconto de 0,5 ponto por commit depois do prazo e ajustes definidos pela coordenação.
        Coeficiente: nota dividida por 100.
      </p>
    </section>
  </div>
</section>
